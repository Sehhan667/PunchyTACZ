{
  "schemaVersion": 1,
  "id": "punchytacz",
  "version": "${version}",
  "name": "Punchy TACZ Animations",
  "description": "Lets Punchy-format packs declare TACZ (Bedrock geo) first-person animations; this mod renders the TACZ rig and hides Punchy's arms for those clips.",
  "authors": [
    "punchytacz"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.punchytacz.PunchyTACZClient"
    ],
    "modmenu": [
      "com.punchytacz.ModMenuIntegration"
    ]
  },
  "mixins": [
    "punchytacz.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "punchy": "*"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
